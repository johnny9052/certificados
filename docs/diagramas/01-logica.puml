@startuml logica
title Vista lógica: modelo de dominio del sistema de certificados

skinparam backgroundColor #17375E
skinparam defaultFontName Arial
skinparam defaultFontColor white
skinparam titleFontColor white
skinparam shadowing false
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam class {
  BackgroundColor #1F4E8C
  BorderColor white
  FontColor white
  AttributeFontColor white
  HeaderBackgroundColor #4F81BD
}
hide circle
hide methods

class Estudiante {
  documento
  programa
}
class Solicitud {
  fecha
  estado
  código de verificación
}
class TipoCertificado {
  nombre
  valor
  requiere pago
}
class Pago {
  referencia
  valor
  estado
}
class Certificado {
  fecha de emisión
  ruta del PDF firmado
}
class IntentoFirma {
  número
  fecha
  resultado
}

Estudiante "1" -- "0..*" Solicitud
Solicitud "0..*" -- "1" TipoCertificado
Solicitud "1" -- "0..1" Pago
Solicitud "1" -- "0..1" Certificado
Solicitud "1" -- "0..5" IntentoFirma
@enduml

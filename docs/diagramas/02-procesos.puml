@startuml procesos
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Vista de procesos: contenedores del sistema de certificados (C4 nivel 2)

Person(estudiante, "Estudiante o egresado", "Solicita, paga y descarga certificados")
Person(funcionario, "Funcionario de Registro", "Revisa solicitudes con novedades")

System_Boundary(sistema, "Sistema de certificados") {
  Container(web, "Aplicación web", "Angular", "Interfaz del estudiante y el funcionario (ADR-009)")
  Container(api, "API de certificados", "Python, monolito modular", "Reglas del trámite (ADR-002)")
  ContainerQueue(broker, "Broker de mensajes", "RabbitMQ", "Cola de firmas (ADR-001)")
  Container(worker, "Worker de firma", "Python", "Firma y reintenta sin perder solicitudes")
  ContainerDb(db, "PostgreSQL", "Base de datos relacional, RT-02", "Solicitudes, pagos, intentos y estados")
  ContainerDb(pdf, "Repositorio de PDF", "Almacenamiento de archivos", "Certificados firmados (ADR-003)")
}

System_Ext(sia, "SIA", "Notas y paz y salvo")
System_Ext(pagos, "Pasarela de pagos", "Cobra el trámite")
System_Ext(firma, "Proveedor de firma", "Firma el PDF (RT-03)")
System_Ext(correo, "Servicio de correo", "Envía notificaciones")

Rel(estudiante, web, "usa", "HTTPS")
Rel(funcionario, web, "revisa", "HTTPS")
Rel(web, api, "invoca", "JSON / HTTPS")
Rel(api, db, "lee y escribe", "SQL")
Rel(api, broker, "publica SolicitudFirma", "AMQP")
Rel(api, sia, "consulta", "API REST, HTTPS")
Rel(api, pagos, "cobra", "HTTPS")
Rel(api, pdf, "lee PDF", "sistema de archivos")
Rel(broker, worker, "entrega", "AMQP")
Rel(worker, firma, "firma", "HTTPS")
Rel(worker, pdf, "guarda PDF", "sistema de archivos")
Rel(worker, db, "registra intentos y estado", "SQL")
Rel(worker, correo, "notifica", "SMTP")
@enduml
